[TEMPLATE]
# Copy this to .env and fill in your real credentials
# NEVER commit .env to git — it's already in .gitignore

MOFID_USER=your_username_here
MOFID_PASS=your_password_here

# ── Broker ──
# BROKER_URL=https://d.easytrader.ir/

# ── Order preparation (automated) ──
# SYMBOL=فولاد               # symbol to trade (required for auto-prep)
# QUANTITY=1                 # number of shares (required for auto-prep)
# PRICE_MODE=ceiling         # ceiling (سقف قیمت) | reference (قیمت پایانی) | fixed
# PRICE=0                    # explicit price — only used when PRICE_MODE=fixed

# ── Timing ──
# DEFAULT_BUY_TIME=08:44:58  # target time (HH:MM:SS) if --time is not given
# CLOCK_POLL_INTERVAL=0.05   # how often the broker clock is polled
# CLOCK_DEADLINE_SECONDS=3600  # give up waiting for the target after this many seconds

# ── Timeouts (seconds) ──
# DEFAULT_TIMEOUT=20
# LOGIN_TIMEOUT=20
# NOTIFY_TIMEOUT=1           # how long to wait for a broker toast
# VERIFY_ORDER_TIMEOUT=10    # how long to wait for the order in the list

# ── Retries ──
# LOGIN_MAX_ATTEMPTS=5
# BUY_MAX_ATTEMPTS=25        # buy click attempts after the target time
# BUY_RETRY_INTERVAL=0.10    # seconds between buy attempts

# ── Result verification ──
# VERIFY_ORDER=true          # check the orders list after a successful click

# ── Logging ──
# LOG_LEVEL=INFO
# LOG_FILE=autobuy.log

# ── Multi-instance settings ──
# CHROME_USER_DATA_DIR=/tmp/chrome-instance-1  # Unique per instance
# HEADLESS=false  # Set to true for headless mode
# INSTANCE_ID=trading-bot-01  # Identifier for this instance
