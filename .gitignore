# Credentials — never commit
.env

# Logs (autobuy.log and any per-instance LOG_FILE)
*.log
# Cached API session token (JSON, chmod 0600) — never commit
.mofid_token*

# Test artifacts (smoke-test screenshots, DOM dumps, discovery profile)
artifacts/

# Python
__pycache__/
*.pyc
.venv/
venv/

# IDE
.vscode/
.idea/
# Freebuff desktop bookkeeping (local, not project code)
.freebuff/
# probe/debug helpers are repo utilities but we keep them explicit

# coverage / IDE / left-overs
.coverage
htmlcov/
coverage.xml
.pytest_cache/
build/
dist/
*.egg-info/
MANIFEST.in

# Environment variants (.env.local, .env.staging, ...) but keep the template
.env.*
!.env.example
